DATABASE_URL=postgres://painel:painel_dev_local@localhost:5433/painel_chamada

PORT=3333

# "development" (padrão) libera CORS pra localhost/127.0.0.1/IP da rede nas portas do Vite
# (5173/4173) automaticamente. Qualquer outro valor exige CORS_ALLOWED_ORIGINS preenchida —
# sem isso, nenhuma origem passa (falha segura, ver cmd/api/main.go).
APP_ENV=development

# Só usada fora de desenvolvimento — lista de origens exatas separadas por vírgula (ex.:
# "https://painel.exemplo.gov.br,https://outra-origem.exemplo.com"). Vazia = nenhuma origem
# passa pelo CORS.
CORS_ALLOWED_ORIGINS=

# Segredo da sessão própria do MVP (JWT HS256 num cookie HttpOnly, ver skill auth-login-mvp) —
# troque por um valor real antes de qualquer deploy fora do seu próprio computador.
SESSAO_SEGREDO=troque-por-um-segredo-local-qualquer-32-chars
